{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://markdowntodiscord.com/schema/benchmark-fixture-v1.json",
  "title": "Markdown to Discord benchmark fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "sourceMarkdown", "expectedDiscordMessages", "categories", "risk", "labelOrigin", "provenance"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "sourceMarkdown": { "type": "string" },
    "expectedDiscordMessages": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "categories": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "risk": { "enum": ["normal", "lossy", "unsafe"] },
    "labelOrigin": { "enum": ["spec", "policy", "observed", "human", "synthetic"] },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceUrl", "license"],
      "properties": {
        "sourceUrl": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "version": { "type": "string" },
        "commit": { "type": "string" },
        "upstreamId": { "type": ["string", "number"] },
        "derivedFrom": { "type": "string" }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxMessageLength": { "type": "integer", "minimum": 32 },
        "neutralizeMentions": { "type": "boolean" }
      }
    },
    "expectedWarningCodes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "notes": { "type": "string" }
  }
}
