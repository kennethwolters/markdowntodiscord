{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://markdowntodiscord.com/schema/loop-adjudicator-output-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["adjudications"],
  "properties": {
    "adjudications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["adjudicationPacketId", "caseHash", "judgmentHashes", "decision", "failureCategories", "rationale"],
        "properties": {
          "adjudicationPacketId": { "type": "string", "minLength": 1 },
          "caseHash": { "$ref": "#/$defs/sha256" },
          "judgmentHashes": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/sha256" } },
          "decision": { "enum": ["pass", "fail", "needs-deterministic-check", "needs-independent-critic", "quarantine"] },
          "failureCategories": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "rationale": { "type": "string", "minLength": 1 }
        },
        "allOf": [
          { "if": { "properties": { "decision": { "const": "pass" } }, "required": ["decision"] }, "then": { "properties": { "failureCategories": { "type": "array", "maxItems": 0 } } } },
          { "if": { "properties": { "decision": { "const": "fail" } }, "required": ["decision"] }, "then": { "properties": { "failureCategories": { "type": "array", "minItems": 1 } } } }
        ]
      }
    }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
