{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://markdowntodiscord.com/schema/loop-packet-v1.json",
  "title": "Blinded critic packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packetId", "caseHash", "presentationNonce", "rubricVersion", "rubricSha256", "policyVersion", "policySha256", "sourceMarkdown", "options", "outputMessages", "warningCodes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "packetId": { "type": "string", "minLength": 1 },
    "caseHash": { "$ref": "#/$defs/sha256" },
    "presentationNonce": { "type": "string", "pattern": "^[a-f0-9]{24}$" },
    "rubricVersion": { "const": "critic-rubric-v1" },
    "rubricSha256": { "$ref": "#/$defs/sha256" },
    "policyVersion": { "enum": ["converter-policy-v1", "converter-policy-v2"] },
    "policySha256": { "$ref": "#/$defs/sha256" },
    "sourceMarkdown": { "type": "string" },
    "options": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "maxMessageLength": { "type": "integer", "minimum": 32 },
        "neutralizeMentions": { "type": "boolean" }
      }
    },
    "outputMessages": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "warningCodes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
