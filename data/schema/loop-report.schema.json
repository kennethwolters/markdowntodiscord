{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://markdowntodiscord.com/schema/loop-report-v1.json",
  "title": "Deterministic loop baseline report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "cases", "splitCounts", "kindCounts", "gold", "invariants", "warningCounts", "failures", "interpretation"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "cases": { "type": "integer", "minimum": 0 },
    "splitCounts": {
      "type": "object", "additionalProperties": false, "required": ["train", "validation", "public-test"],
      "properties": { "train": { "type": "integer", "minimum": 0 }, "validation": { "type": "integer", "minimum": 0 }, "public-test": { "type": "integer", "minimum": 0 } }
    },
    "kindCounts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "gold": {
      "type": "object", "additionalProperties": false, "required": ["total", "passed", "failed"],
      "properties": { "total": { "type": "integer", "minimum": 0 }, "passed": { "type": "integer", "minimum": 0 }, "failed": { "type": "integer", "minimum": 0 } }
    },
    "invariants": {
      "type": "object", "additionalProperties": false,
      "required": ["failedCases", "deterministic", "withinCapacity", "balancedFences", "activeMentionsAbsent", "mentionPolicyConformant"],
      "properties": {
        "failedCases": { "type": "integer", "minimum": 0 },
        "deterministic": { "type": "integer", "minimum": 0 },
        "withinCapacity": { "type": "integer", "minimum": 0 },
        "balancedFences": { "type": "integer", "minimum": 0 },
        "activeMentionsAbsent": { "type": "integer", "minimum": 0 },
        "mentionPolicyConformant": { "type": "integer", "minimum": 0 }
      }
    },
    "warningCounts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "failures": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "interpretation": { "type": "string", "minLength": 1 }
  }
}
