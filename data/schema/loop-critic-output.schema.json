{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://markdowntodiscord.com/schema/loop-critic-output-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["judgments"],
  "properties": {
    "judgments": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["packetId", "caseHash", "scores", "verdict", "citations", "confidence"],
        "properties": {
          "packetId": { "type": "string", "minLength": 1 },
          "caseHash": { "$ref": "#/$defs/sha256" },
          "scores": {
            "type": "object", "additionalProperties": false,
            "required": ["semanticPreservation", "discordCompatibility", "readability", "continuity", "formatBalance", "safety", "informationIntegrity", "overallAcceptability"],
            "properties": {
              "semanticPreservation": { "$ref": "#/$defs/score" }, "discordCompatibility": { "$ref": "#/$defs/score" },
              "readability": { "$ref": "#/$defs/score" }, "continuity": { "$ref": "#/$defs/score" },
              "formatBalance": { "$ref": "#/$defs/score" }, "safety": { "$ref": "#/$defs/score" },
              "informationIntegrity": { "$ref": "#/$defs/score" }, "overallAcceptability": { "$ref": "#/$defs/score" }
            }
          },
          "verdict": { "enum": ["pass", "fail", "abstain"] },
          "citations": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["side", "start", "end", "rule", "explanation"],
              "properties": {
                "side": { "enum": ["source", "output"] }, "start": { "type": "integer", "minimum": 0 },
                "end": { "type": "integer", "minimum": 0 }, "rule": { "type": "string", "minLength": 1 },
                "explanation": { "type": "string", "minLength": 1 }
              }
            }
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "abstentionReason": { "type": "string", "minLength": 1 }
        },
        "allOf": [
          { "if": { "properties": { "verdict": { "const": "fail" } }, "required": ["verdict"] }, "then": { "properties": { "citations": { "type": "array", "minItems": 1 } } } },
          { "if": { "properties": { "verdict": { "const": "abstain" } }, "required": ["verdict"] }, "then": { "required": ["abstentionReason"] } },
          { "if": { "properties": { "verdict": { "enum": ["pass", "fail"] } }, "required": ["verdict"] }, "then": { "not": { "required": ["abstentionReason"] } } }
        ]
      }
    }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "score": { "type": "integer", "minimum": 1, "maximum": 5 } }
}
