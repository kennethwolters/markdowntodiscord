{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://markdowntodiscord.com/schema/eval-adjudication-v2.json",
  "title": "Blinded semantic escalation decisions v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "adjudicationId", "candidateSetId", "candidateManifestSha256", "modelIdentity", "thinking", "promptVersion", "promptSha256", "policySha256", "completedAt", "decisions"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "adjudicationId": { "type": "string", "minLength": 1 },
    "candidateSetId": { "const": "semantic-eval-candidates-v2" },
    "candidateManifestSha256": { "$ref": "#/$defs/sha256" },
    "modelIdentity": { "const": "openai-codex/gpt-6-astra" },
    "thinking": { "const": "xhigh" },
    "promptVersion": { "const": "semantic-adjudicator-prompt-v3" },
    "promptSha256": { "$ref": "#/$defs/sha256" },
    "policySha256": { "$ref": "#/$defs/sha256" },
    "completedAt": { "type": "string", "format": "date-time" },
    "decisions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["candidateId", "reviewHashes", "decision", "rationale"],
        "properties": {
          "candidateId": { "type": "string", "pattern": "^eval-v2-[a-f0-9]{16}$" },
          "reviewHashes": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/sha256" } },
          "decision": { "enum": ["select-a", "select-b", "author", "quarantine"] },
          "rationale": { "type": "string", "minLength": 1 },
          "categories": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "risk": { "enum": ["normal", "lossy", "unsafe"] },
          "label": { "$ref": "eval-review-v2.json#/$defs/label" }
        },
        "allOf": [{
          "if": { "properties": { "decision": { "const": "author" } }, "required": ["decision"] },
          "then": { "required": ["categories", "risk", "label"], "properties": { "categories": true, "risk": true, "label": true } },
          "else": { "properties": { "categories": false, "risk": false, "label": false } }
        }]
      }
    }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
