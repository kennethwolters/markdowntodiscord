{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://markdowntodiscord.com/schema/loop-pilot-manifest-v1.json",
  "title": "Blinded critic pilot manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "pilotId", "status", "records", "selection", "inputs", "artifacts", "disclosure"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "pilotId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["prepared", "running", "complete", "failed"] },
    "records": { "type": "integer", "minimum": 1 },
    "selection": {
      "type": "object", "additionalProperties": false,
      "required": ["policyGold", "commonmarkTrainInvariant", "mutantTrainInvariant"],
      "properties": {
        "policyGold": { "type": "integer", "minimum": 0 },
        "commonmarkTrainInvariant": { "type": "integer", "minimum": 0 },
        "mutantTrainInvariant": { "type": "integer", "minimum": 0 }
      }
    },
    "inputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/file" } },
    "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/file" } },
    "disclosure": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "file": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/sha256" } }
    }
  }
}
