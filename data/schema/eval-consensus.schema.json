{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://markdowntodiscord.com/schema/eval-consensus-v2.json",
  "title": "Frozen model-evidence semantic evaluation case v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "source", "split", "portfolioBucket", "categories", "risk", "options", "label", "evidence"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "id": { "type": "string", "pattern": "^eval-v2-[a-f0-9]{16}$" },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["family", "contentSha256", "lineageId", "sourceMarkdown", "provenance"],
      "properties": {
        "family": { "enum": ["oasst", "wildchat", "github", "spec", "synthetic", "observed"] },
        "contentSha256": { "$ref": "#/$defs/sha256" },
        "lineageId": { "type": "string", "minLength": 1 },
        "sourceMarkdown": { "type": "string", "minLength": 1 },
        "provenance": {
          "type": "object", "additionalProperties": false,
          "required": ["dataset", "revision", "upstreamRecordHash", "license", "privacyState"],
          "properties": {
            "dataset": { "type": "string", "minLength": 1 },
            "revision": { "type": "string", "minLength": 1 },
            "upstreamRecordHash": { "$ref": "#/$defs/sha256" },
            "license": { "type": "string", "minLength": 1 },
            "privacyState": { "const": "model-screened" },
            "redactionVersion": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "split": { "enum": ["validation", "challenge"] },
    "portfolioBucket": { "enum": ["representative-natural", "long-splitting", "high-risk-discord", "feature-interaction", "boundary-adversarial"] },
    "categories": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "risk": { "enum": ["normal", "lossy", "unsafe"] },
    "options": { "type": "object", "additionalProperties": false, "properties": { "maxMessageLength": { "type": "integer", "minimum": 32 }, "neutralizeMentions": { "type": "boolean" } } },
    "label": { "$ref": "eval-review-v2.json#/$defs/label" },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["authority", "rubricVersion", "reviews", "frozenAt"],
      "properties": {
        "authority": { "enum": ["dual-luna-consensus", "astra-adjudicated-model-consensus", "astra-authored-silver"] },
        "rubricVersion": { "const": "semantic-model-rubric-v2" },
        "reviews": {
          "type": "array", "minItems": 2, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["reviewerId", "modelIdentity", "thinking", "promptSha256", "reviewSha256"],
            "properties": {
              "reviewerId": { "type": "string", "minLength": 1 },
              "modelIdentity": { "type": "string", "minLength": 1 },
              "thinking": { "type": "string", "minLength": 1 },
              "promptSha256": { "$ref": "#/$defs/sha256" },
              "reviewSha256": { "$ref": "#/$defs/sha256" }
            }
          }
        },
        "adjudicationSha256": { "$ref": "#/$defs/sha256" },
        "frozenAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
