{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://markdowntodiscord.com/schema/eval-candidate-manifest-v2.json",
  "title": "Semantic evaluation candidate manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "candidateSetId", "status", "records", "selectionPolicy", "quotas", "splitCounts", "bucketCounts", "sourceCounts", "featureCounts", "languageCounts", "highImpact", "interactions", "over2000CodePoints", "inputs", "artifacts", "disclosure"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "candidateSetId": { "const": "semantic-eval-candidates-v2" },
    "status": { "const": "awaiting-dual-model-review" },
    "records": { "type": "integer", "minimum": 40 },
    "selectionPolicy": { "const": "portfolio-quota-lineage-split-v2" },
    "quotas": { "$ref": "#/$defs/counts" },
    "splitCounts": { "$ref": "#/$defs/counts" },
    "bucketCounts": { "$ref": "#/$defs/counts" },
    "sourceCounts": { "$ref": "#/$defs/counts" },
    "featureCounts": { "$ref": "#/$defs/counts" },
    "languageCounts": { "$ref": "#/$defs/counts" },
    "highImpact": { "type": "integer", "minimum": 0 },
    "interactions": { "type": "integer", "minimum": 0 },
    "over2000CodePoints": { "type": "integer", "minimum": 0 },
    "inputs": { "$ref": "#/$defs/files" },
    "artifacts": { "$ref": "#/$defs/files" },
    "disclosure": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "counts": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "integer", "minimum": 0 } },
    "files": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
        "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/sha256" } }
      }
    }
  }
}
