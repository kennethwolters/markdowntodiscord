{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://markdowntodiscord.com/schema/loop-calibration-manifest-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "calibrationId", "status", "records", "positiveControls", "negativeControls", "inputs", "artifacts", "disclosure"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "calibrationId": { "const": "critic-calibration-v1" },
    "status": { "enum": ["prepared", "running", "complete", "failed"] },
    "records": { "type": "integer", "minimum": 1 },
    "positiveControls": { "type": "integer", "minimum": 1 },
    "negativeControls": { "type": "integer", "minimum": 1 },
    "inputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/file" } },
    "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/file" } },
    "disclosure": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "file": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/sha256" } } }
  }
}
