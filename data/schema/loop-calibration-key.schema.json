{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://markdowntodiscord.com/schema/loop-calibration-key-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "calibrationId", "answers"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "calibrationId": { "const": "critic-calibration-v1" },
    "answers": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["packetId", "caseHash", "expectedVerdict", "control", "baselineCaseId"],
        "properties": {
          "packetId": { "type": "string", "minLength": 1 },
          "caseHash": { "$ref": "#/$defs/sha256" },
          "expectedVerdict": { "enum": ["pass", "fail"] },
          "control": { "enum": ["gold-positive", "append-active-mention", "truncate-output", "drop-output", "unbalanced-fence", "over-capacity"] },
          "baselineCaseId": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
