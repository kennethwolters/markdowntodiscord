{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://markdowntodiscord.com/schema/loop-run-v1.json",
  "title": "Agentic optimization run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "runKind", "status", "converterIdentity", "runtime", "runtimeCompatibility", "segmentationLocale", "sources", "splitPolicy", "artifacts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "runKind": { "enum": ["baseline", "evaluation", "optimization", "gate"] },
    "status": { "enum": ["prepared", "running", "complete", "failed"] },
    "converterIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceSha256", "policyFixtureSha256"],
      "properties": {
        "repositoryCommit": { "type": ["string", "null"] },
        "sourceSha256": { "$ref": "#/$defs/sha256" },
        "policyFixtureSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "platform", "architecture", "icu", "unicode"],
      "properties": {
        "node": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 },
        "icu": { "type": "string", "minLength": 1 },
        "unicode": { "type": "string", "minLength": 1 }
      }
    },
    "runtimeCompatibility": { "const": "node-icu-unicode-locale-v1" },
    "segmentationLocale": { "const": "en" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "records"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "records": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "splitPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "unit", "train", "validation", "publicTest"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "unit": { "const": "source-lineage" },
        "train": { "type": "integer", "minimum": 0, "maximum": 100 },
        "validation": { "type": "integer", "minimum": 0, "maximum": 100 },
        "publicTest": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "notes": { "type": "string" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
